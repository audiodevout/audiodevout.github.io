{
  "manifest_version": 3,
  "name": "News Button for YouTube",
  "short_name": "News Button",
  "version": "1.0.0",
  "description": "YouTube removed the News button but the page still works. This brings it back and lets you open other countries' News too.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "News Button for YouTube",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["countries.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-sidebar": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Open YouTube News for every country shown in the sidebar"
    }
  }
}
